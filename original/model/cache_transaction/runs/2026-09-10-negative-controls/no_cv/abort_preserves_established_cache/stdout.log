theory CacheTransaction

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, pk/1, sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true

rule (modulo E) Setup:
   [ Fr( ~ca ), Fr( ~sk ) ]
  --[ Initialised( 'client', 'server' ) ]->
   [
   !Trust( 'client', 'server', pk(~ca) ),
   !Server( 'server', ~sk, sign(<'cert', 'server', pk(~sk)>, ~ca) ),
   Out( <pk(~ca), pk(~sk), sign(<'cert', 'server', pk(~sk)>, ~ca)> ),
   Cache( 'client', 'server', 'empty', 'initial' ),
   !Next( 'initial', 'probe' ), !Next( 'probe', 'reconnect' ),
   !Next( 'reconnect', 'done' ), !Keep( 'empty', 'zero' ),
   !Keep( 'empty', 'nonzero' ), !Keep( 'pq', 'nonzero' )
   ]

  /* has exactly the trivial AC variant */

restriction setup_once:
  "∀ C S #i #j.
    ((Initialised( C, S ) @ #i) ∧ (Initialised( C, S ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ C S #i #j.
    ((Initialised( C, S ) @ #i) ∧ (Initialised( C, S ) @ #j)) ⇒ (#i = #j)"
  */

restriction equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

rule (modulo E) Policy:
   [ ] --> [ !Policy( 'defer' ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Start:
   [ Cache( $C, $S, state, phase ), !Next( phase, next ), Fr( ~n ) ]
  --[ Opened( $C, $S, ~n, state ) ]->
   [ Waiting( $C, $S, ~n, state, phase ), Out( <'hello', $S, ~n> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) ServerRespond:
   [ In( <'request', $S, n, value> ), !Server( $S, ~sk, cert ) ]
  --[ ServerSent( $S, n, value, pk(~sk), cert ) ]->
   [
   Out( <'response', $S, n, value, pk(~sk), cert, 
         sign(<'cv', $S, n, value, pk(~sk), cert>, ~sk)>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) ParseDeferred:
   [
   Waiting( $C, $S, ~n, state, phase ), !Policy( 'defer' ),
   In( <'response', $S, ~n, value, key, cert, sig> )
   ]
  --[ Parsed( $C, $S, ~n, value ) ]->
   [ Pending( $C, $S, ~n, state, phase, value, key, cert, sig ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) ParseEarlyClear:
   [
   Waiting( $C, $S, ~n, 'pq', phase ), !Policy( 'early' ),
   In( <'response', $S, ~n, 'zero', key, cert, sig> )
   ]
  --[
  Parsed( $C, $S, ~n, 'zero' ),
  CacheCleared( $C, $S, ~n, 'zero', key, cert )
  ]->
   [ Pending( $C, $S, ~n, 'empty', phase, 'zero', key, cert, sig ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) ParseEarlyKeep:
   [
   Waiting( $C, $S, ~n, state, phase ), !Policy( 'early' ),
   !Keep( state, value ), In( <'response', $S, ~n, value, key, cert, sig> )
   ]
  --[ Parsed( $C, $S, ~n, value ) ]->
   [ Pending( $C, $S, ~n, state, phase, value, key, cert, sig ) ]

  // loop breaker: [0]
  /* has exactly the trivial AC variant */

rule (modulo E) ValidateCertificate:
   [
   Pending( $C, $S, ~n, state, phase, value, key, cert, sig ),
   !Trust( $C, $S, ca )
   ]
  --[
  Eq( verify(cert, <'cert', $S, key>, ca), true ),
  ChainValidated( $C, $S, ~n )
  ]->
   [ Validated( $C, $S, ~n, state, phase, value, key, cert, sig ) ]

  /*
  rule (modulo AC) ValidateCertificate:
     [
     Pending( $C, $S, ~n, state, phase, value, key, cert, sig ),
     !Trust( $C, $S, ca )
     ]
    --[ Eq( z, true ), ChainValidated( $C, $S, ~n ) ]->
     [ Validated( $C, $S, ~n, state, phase, value, key, cert, sig ) ]
    variants (modulo AC)
    1. $S    = $S.12
       ca    = ca.12
       cert  = cert.12
       key   = key.12
       z     = verify(cert.12, <'cert', $S.12, key.12>, ca.12)
    
    2. $S    = $x.12
       ca    = pk(x.14)
       cert  = sign(<'cert', $x.12, x.15>, x.14)
       key   = x.15
       z     = true
  */

rule (modulo E) CheckCV:
   [ Validated( $C, $S, ~n, state, phase, value, key, cert, sig ) ]
  --[ Authenticated( $C, $S, ~n, value, key, cert ) ]->
   [ ReadyCommit( $C, $S, ~n, state, phase, value, key, cert ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CommitPositive:
   [
   ReadyCommit( $C, $S, ~n, state, phase, 'nonzero', key, cert ),
   !Next( phase, next )
   ]
  --[ Completed( $C, $S, ~n, 'nonzero' ), CacheEstablished( $C, $S, ~n )
  ]->
   [ Cache( $C, $S, 'pq', next ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CommitWithdrawal:
   [
   ReadyCommit( $C, $S, ~n, 'pq', phase, 'zero', key, cert ),
   !Next( phase, next )
   ]
  --[
  Completed( $C, $S, ~n, 'zero' ),
  CacheCleared( $C, $S, ~n, 'zero', key, cert )
  ]->
   [ Cache( $C, $S, 'empty', next ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompleteEmpty:
   [
   ReadyCommit( $C, $S, ~n, 'empty', phase, 'zero', key, cert ),
   !Next( phase, next )
   ]
  --[ Completed( $C, $S, ~n, 'zero' ) ]->
   [ Cache( $C, $S, 'empty', next ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AbortAfterParse:
   [
   Pending( $C, $S, ~n, state, phase, value, key, cert, sig ),
   !Next( phase, next ), In( <'cancel', ~n> )
   ]
  --[ Aborted( $C, $S, ~n, state ) ]->
   [ Cache( $C, $S, state, next ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) AbortAfterChain:
   [
   Validated( $C, $S, ~n, state, phase, value, key, cert, sig ),
   !Next( phase, next ), In( <'cancel', ~n> )
   ]
  --[ Aborted( $C, $S, ~n, state ) ]->
   [ Cache( $C, $S, state, next ) ]

  /* has exactly the trivial AC variant */

lemma clearing_has_matching_server:
  all-traces
  "∀ C S n key cert #i.
    (CacheCleared( C, S, n, 'zero', key, cert ) @ #i) ⇒
    (∃ #j. (ServerSent( S, n, 'zero', key, cert ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ C S n key cert #i.
  (CacheCleared( C, S, n, 'zero', key, cert ) @ #i)
 ∧
  ∀ #j. (ServerSent( S, n, 'zero', key, cert ) @ #j) ⇒ ¬(#j < #i)"
*/
by sorry

lemma abort_preserves_established_cache:
  all-traces
  "∀ C S n state #i #j.
    (((Opened( C, S, n, 'pq' ) @ #i) ∧ (Aborted( C, S, n, state ) @ #j)) ∧
     (#i < #j)) ⇒
    (state = 'pq')"
/*
guarded formula characterizing all counter-examples:
"∃ C S n state #i #j.
  (Opened( C, S, n, 'pq' ) @ #i) ∧ (Aborted( C, S, n, state ) @ #j)
 ∧
  (#i < #j) ∧ (¬(state = 'pq'))"
*/
simplify
solve( Cache( $C, $S, 'pq', phase ) ▶₀ #i )
  case AbortAfterChain_case_1
  solve( !Next( 'probe', next ) ▶₁ #i )
    case Setup
    solve( Aborted( 'client', 'server', ~n, state ) @ #j )
      case AbortAfterChain
      solve( Validated( 'client', 'server', ~n, state, phase, value, key, cert,
                        sig
             ) ▶₀ #j )
        case ValidateCertificate
        solve( !Next( phase, next ) ▶₁ #j )
          case Setup_case_1
          by solve( Waiting( 'client', 'server', ~n.1, 'pq', 'initial' ) ▶₀ #vr.3 )
        next
          case Setup_case_2
          by solve( Waiting( 'client', 'server', ~n.1, 'pq', 'initial' ) ▶₀ #vr.3 )
        next
          case Setup_case_3
          by solve( Waiting( 'client', 'server', ~n.1, 'pq', 'initial' ) ▶₀ #vr.3 )
        qed
      qed
    next
      case AbortAfterParse
      solve( Pending( 'client', 'server', ~n, state, phase, value, key, cert,
                      sig
             ) ▶₀ #j )
        case ParseDeferred
        solve( !Next( phase, next ) ▶₁ #j )
          case Setup_case_1
          by solve( Waiting( 'client', 'server', ~n.1, 'pq', 'initial' ) ▶₀ #vr.3 )
        next
          case Setup_case_2
          by solve( Waiting( 'client', 'server', ~n.1, 'pq', 'initial' ) ▶₀ #vr.3 )
        next
          case Setup_case_3
          by solve( Waiting( 'client', 'server', ~n.1, 'pq', 'initial' ) ▶₀ #vr.3 )
        qed
      qed
    qed
  qed
next
  case AbortAfterChain_case_2
  solve( !Next( 'reconnect', next ) ▶₁ #i )
    case Setup
    solve( Aborted( 'client', 'server', ~n, state ) @ #j )
      case AbortAfterChain
      solve( Validated( 'client', 'server', ~n, state, phase, value, key, cert,
                        sig
             ) ▶₀ #j )
        case ValidateCertificate
        solve( !Next( phase, next ) ▶₁ #j )
          case Setup_case_1
          solve( Waiting( 'client', 'server', ~n.1, 'pq', 'probe' ) ▶₀ #vr.3 )
            case Start_case_1
            by solve( Waiting( 'client', 'server', ~n, state, 'initial' ) ▶₀ #vr.6 )
          next
            case Start_case_2
            by solve( Waiting( 'client', 'server', ~n, state, 'initial' ) ▶₀ #vr.6 )
          next
            case Start_case_3
            by solve( Waiting( 'client', 'server', ~n, state, 'initial' ) ▶₀ #vr.6 )
          qed
        next
          case Setup_case_2
          solve( Waiting( 'client', 'server', ~n.1, 'pq', 'probe' ) ▶₀ #vr.3 )
            case Start_case_1
            by solve( Waiting( 'client', 'server', ~n, state, 'probe' ) ▶₀ #vr.6 )
          next
            case Start_case_2
            by solve( Waiting( 'client', 'server', ~n, state, 'probe' ) ▶₀ #vr.6 )
          next
            case Start_case_3
            by solve( Waiting( 'client', 'server', ~n, state, 'probe' ) ▶₀ #vr.6 )
          qed
        next
          case Setup_case_3
          solve( Waiting( 'client', 'server', ~n.1, 'pq', 'probe' ) ▶₀ #vr.3 )
            case Start_case_1
            solve( Waiting( 'client', 'server', ~n, state, 'reconnect' ) ▶₀ #vr.6 )
              case Start
              by contradiction /* from formulas */
            qed
          next
            case Start_case_2
            solve( Waiting( 'client', 'server', ~n, state, 'reconnect' ) ▶₀ #vr.6 )
              case Start
              by contradiction /* from formulas */
            qed
          next
            case Start_case_3
            solve( Waiting( 'client', 'server', ~n, state, 'reconnect' ) ▶₀ #vr.6 )
              case Start
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    next
      case AbortAfterParse
      solve( Pending( 'client', 'server', ~n, state, phase, value, key, cert,
                      sig
             ) ▶₀ #j )
        case ParseDeferred
        solve( !Next( phase, next ) ▶₁ #j )
          case Setup_case_1
          solve( Waiting( 'client', 'server', ~n.1, 'pq', 'probe' ) ▶₀ #vr.3 )
            case Start_case_1
            by solve( Waiting( 'client', 'server', ~n, state, 'initial' ) ▶₀ #vr.5 )
          next
            case Start_case_2
            by solve( Waiting( 'client', 'server', ~n, state, 'initial' ) ▶₀ #vr.5 )
          next
            case Start_case_3
            by solve( Waiting( 'client', 'server', ~n, state, 'initial' ) ▶₀ #vr.5 )
          qed
        next
          case Setup_case_2
          solve( Waiting( 'client', 'server', ~n.1, 'pq', 'probe' ) ▶₀ #vr.3 )
            case Start_case_1
            by solve( Waiting( 'client', 'server', ~n, state, 'probe' ) ▶₀ #vr.5 )
          next
            case Start_case_2
            by solve( Waiting( 'client', 'server', ~n, state, 'probe' ) ▶₀ #vr.5 )
          next
            case Start_case_3
            by solve( Waiting( 'client', 'server', ~n, state, 'probe' ) ▶₀ #vr.5 )
          qed
        next
          case Setup_case_3
          solve( Waiting( 'client', 'server', ~n.1, 'pq', 'probe' ) ▶₀ #vr.3 )
            case Start_case_1
            solve( Waiting( 'client', 'server', ~n, state, 'reconnect' ) ▶₀ #vr.5 )
              case Start
              by contradiction /* from formulas */
            qed
          next
            case Start_case_2
            solve( Waiting( 'client', 'server', ~n, state, 'reconnect' ) ▶₀ #vr.5 )
              case Start
              by contradiction /* from formulas */
            qed
          next
            case Start_case_3
            solve( Waiting( 'client', 'server', ~n, state, 'reconnect' ) ▶₀ #vr.5 )
              case Start
              by contradiction /* from formulas */
            qed
          qed
        qed
      qed
    qed
  qed
next
  case AbortAfterChain_case_3
  by solve( !Next( 'done', next ) ▶₁ #i )
next
  case AbortAfterParse_case_1
  solve( !Next( 'probe', next ) ▶₁ #i )
    case Setup
    solve( Aborted( $C, $S, ~n, state ) @ #j )
      case AbortAfterChain
      solve( Validated( $C, $S, ~n, state, phase, value, key, cert, sig
             ) ▶₀ #j )
        case ValidateCertificate
        solve( !Next( phase, next ) ▶₁ #j )
          case Setup_case_1
          by solve( Waiting( 'client', 'server', ~n.1, 'pq', 'initial' ) ▶₀ #vr.1 )
        next
