          qed
        next
          case Setup_case_3
          solve( Waiting( 'client', 'server', ~n.1, 'pq', 'probe' ) ▶₀ #vr.1 )
            case Start_case_1
            solve( Waiting( 'client', 'server', ~n, state, 'reconnect' ) ▶₀ #vr.5 )
