          next
            case Start_case_3
            by solve( Waiting( 'client', 'server', ~n, state, 'initial' ) ▶₀ #vr.5 )
          qed
        next
          case Setup_case_2
          solve( Waiting( 'client', 'server', ~n.1, 'pq', 'probe' ) ▶₀ #vr.1 )
            case Start_case_1
            by solve( Waiting( 'client', 'server', ~n, state, 'probe' ) ▶₀ #vr.5 )
          next
            case Start_case_2
            by solve( Waiting( 'client', 'server', ~n, state, 'probe' ) ▶₀ #vr.5 )
          next
            case Start_case_3
