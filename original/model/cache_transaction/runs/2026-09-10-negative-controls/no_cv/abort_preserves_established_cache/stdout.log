    next
      case AbortAfterParse
      solve( Pending( $C, $S, ~n, state, phase, value, key, cert, sig ) ▶₀ #j )
        case ParseDeferred
        solve( !Next( phase, next ) ▶₁ #j )
          case Setup_case_1
          by solve( Waiting( $C, $S, ~n.1, 'pq', 'initial' ) ▶₀ #vr.1 )
        next
          case Setup_case_2
          by solve( Waiting( $C, $S, ~n.1, 'pq', 'initial' ) ▶₀ #vr.1 )
        next
          case Setup_case_3
          by solve( Waiting( $C, $S, ~n.1, 'pq', 'initial' ) ▶₀ #vr.1 )
        qed
      qed
    qed
  qed
next
  case AbortAfterParse_case_2
  solve( !Next( 'reconnect', next ) ▶₁ #i )
    case Setup
    solve( Aborted( $C, $S, ~n, state ) @ #j )
      case AbortAfterChain
      solve( Validated( $C, $S, ~n, state, phase, value, key, cert, sig
