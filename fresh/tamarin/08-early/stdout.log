rule (modulo E) CommitPositive:
   [
   ReadyCommit( $C, $S, ~n, state, phase, 'nonzero', key, cert ),
   !Next( phase, next )
   ]
  --[ Completed( $C, $S, ~n, 'nonzero' ), CacheEstablished( $C, $S, ~n )
  ]->
   [ Cache( $C, $S, 'pq', next ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CommitWithdrawal:
   [
   ReadyCommit( $C, $S, ~n, 'pq', phase, 'zero', key, cert ),
   !Next( phase, next )
   ]
  --[
  Completed( $C, $S, ~n, 'zero' ),
  CacheCleared( $C, $S, ~n, 'zero', key, cert )
  ]->
   [ Cache( $C, $S, 'empty', next ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) CompleteEmpty:
   [
   ReadyCommit( $C, $S, ~n, 'empty', phase, 'zero', key, cert ),
   !Next( phase, next )
   ]
  --[ Completed( $C, $S, ~n, 'zero' ) ]->
