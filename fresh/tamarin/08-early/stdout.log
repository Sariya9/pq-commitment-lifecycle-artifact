 ∧
  (#i < #j) ∧ (#j < #k)"
*/
simplify
solve( ReadyCommit( $C, $S, ~n, state, phase, 'nonzero', key, cert
       ) ▶₀ #i )
  case CheckCV_case_1
  solve( !Next( phase, next ) ▶₁ #i )
    case Setup_case_1
    solve( !Server( 'server', ~sk, cert ) ▶₁ #j )
      case Setup
      solve( CacheCleared( 'client', 'server', n.1, 'zero', pk(~sk),
                           sign(<'cert', 'server', pk(~sk)>, ~ca)
             ) @ #k )
        case ParseEarlyClear
        solve( !Policy( 'early' ) ▶₁ #k )
          case Policy
          solve( Waiting( 'client', 'server', ~n, 'empty', 'initial' ) ▶₀ #vr.2 )
            case Start
            solve( Waiting( 'client', 'server', ~n.1, 'pq', phase ) ▶₀ #k )
              case Start_case_1
              solve( Waiting( 'client', 'server', ~n.2, 'empty', 'initial'
                     ) ▶₀ #vr.11 )
                case Start
                solve( !KU( sign(<'cert', 'server', pk(x)>, ~ca) ) @ #vk.21 )
                  case ServerRespond
                  solve( !KU( sign(<'cv', 'server', ~n, 'nonzero', pk(~sk), 
                                    sign(<'cert', 'server', pk(~sk)>, ~ca)>,
                                   ~sk)
                         ) @ #vk.26 )
                    case ServerRespond
                    solve( !KU( ~n ) @ #vk.23 )
                      case Start
                      solve( !KU( ~n.1 ) @ #vk.20 )
                        case Start
                        solve( !KU( pk(~sk) ) @ #vk.29 )
                          case ServerRespond
                          SOLVED // trace found
                        qed
                      qed
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

